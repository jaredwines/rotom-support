#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
FAILURES=0

pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }

require_file() {
    local path="$1"
    [[ "$path" == 0[0-8]-* ]] && path="runbook/$path"
    [[ -f "$REPO_ROOT/$path" ]] && pass "exists: $path" || fail "missing: $path"
}

require_text() {
    local path="$1" text="$2"
    [[ "$path" == 0[0-8]-* ]] && path="runbook/$path"
    local file="$REPO_ROOT/$path"
    grep -Fq -- "$text" "$file" && pass "$1: $text" || fail "$1: missing $text"
}

reject_text() {
    local text="$1"
    shift
    if grep -Fq -- "$text" "$@"; then
        fail "obsolete current-state assertion remains: $text"
    else
        pass "obsolete current-state assertion absent: $text"
    fi
}

for n in 00 01 02 03 04 05 06 07 08; do
    count=$(find "$REPO_ROOT/runbook" -maxdepth 1 -type f -name "$n-*" | wc -l)
    [[ "$count" -eq 1 ]] && pass "one numbered source for $n" || fail "expected one numbered source for $n; found $count"
done

numbered_count=$(find "$REPO_ROOT/runbook" -maxdepth 1 -type f \( -name '0[0-7]-*.md' -o -name '08-*.txt' \) | wc -l)
[[ "$numbered_count" -eq 9 ]] && pass "nine numbered RR sources" || fail "expected nine numbered RR sources; found $numbered_count"

if find "$REPO_ROOT" -maxdepth 1 -type f \( -name '0[0-7]-*.md' -o -name '08-*.txt' \) | grep -q .; then
    fail "numbered RR source remains at repository root"
else
    pass "numbered RR sources are not at repository root"
fi

if find "$REPO_ROOT/runbook" -maxdepth 1 -type f -name '09-*' | grep -q .; then
    fail "numbered 09 source remains in runbook directory"
else
    pass "supplementary guide is outside the numbered RR set"
fi

for file in \
    00-Rotom-Change-Log.md 01-Rotom-Server-Inventory.md 02-Docker-Services.md \
    03-Network-and-Domains.md 04-NAS-and-Storage.md 05-Backup-and-Restore.md \
    06-Maintenance-and-Automation.md 07-Users-and-Permissions.md 08-Rotom-Directory-Tree.txt
do
    require_file "$file"
done

require_text 00-Rotom-Change-Log.md "### Runbook-First Maintenance Standard"
require_text 00-Rotom-Change-Log.md "An RS update is incomplete if it changes how Rotom is operated, diagnosed, maintained, or recovered"
require_text 00-Rotom-Change-Log.md "internals/tooling/test-rr-runbooks"
require_text 00-Rotom-Change-Log.md 'The sole canonical documentation-update command is **`Update the RS`**'
require_text README.md "# Rotom Support"
require_text AGENTS.md "## RS Git workflow"
require_text AGENTS.md 'Rotom Support (RS) is all intentionally tracked content in this repository'
require_text AGENTS.md '`runbook/` is the primary authority for Rotom'
require_text AGENTS.md 'Available Sources is a separate, manually maintained publication or reference destination'
require_text README.md 'Every tracked file under `guide/` is an RS component but remains outside the Core Numbered Reference Set'
require_text 01-Rotom-Server-Inventory.md 'Rotom Support is all intentionally tracked content in the Rotom-Support repository'
require_text 01-Rotom-Server-Inventory.md 'If another RS component conflicts with the applicable current runbook'
require_file internals/tooling/rs
require_file internals/tooling/rr
require_file internals/tooling/test-rs-cli
require_file internals/tooling/test-rr-cli
require_file internals/tooling/test-guides
require_file internals/publisher/build-input.py
require_file internals/publisher/sync
require_file internals/publisher/test-publisher.py
require_file internals/publisher/rotom-support-sync.timer
require_text 01-Rotom-Server-Inventory.md "## Start by Task or Symptom"
require_text 01-Rotom-Server-Inventory.md "### Maintaining the Runbook-First Model"
require_text 01-Rotom-Server-Inventory.md "00-Rotom-Change-Log.md#runbook-first-maintenance-standard"
require_text 01-Rotom-Server-Inventory.md "SSH alias, target account, authentication method, or access-policy lookup"

for file in 02-Docker-Services.md 03-Network-and-Domains.md 04-NAS-and-Storage.md \
            05-Backup-and-Restore.md 06-Maintenance-and-Automation.md 07-Users-and-Permissions.md
do
    require_text "$file" "## Start by Task or Symptom"
    require_text "$file" "Stop conditions"
    require_text "$file" "Read-only"
done

for file in 02-Docker-Services.md 03-Network-and-Domains.md 04-NAS-and-Storage.md \
            05-Backup-and-Restore.md 06-Maintenance-and-Automation.md 07-Users-and-Permissions.md
do
    require_text "$file" "## Maintenance and Revalidation Triggers"
    require_text "$file" "00-Rotom-Change-Log.md#runbook-first-maintenance-standard"
done
require_text 08-Rotom-Directory-Tree.txt "# MAINTENANCE AND REVALIDATION TRIGGERS"
require_text 08-Rotom-Directory-Tree.txt "# CURRENT TOPOLOGY"
require_text 08-Rotom-Directory-Tree.txt "# PRE-MIGRATION RESTORATION TARGET"
require_text 08-Rotom-Directory-Tree.txt "# RETIRED PATH WARNINGS"
require_text 08-Rotom-Directory-Tree.txt "# RECOVERY RULES"

require_text 02-Docker-Services.md "## Diagnose and Recover a Container or Docker-Backed Website"
require_text 04-NAS-and-Storage.md "## Diagnose and Recover a Configured NAS Mount"
require_text 04-NAS-and-Storage.md "mnt-nas\\x2dlibraries.automount"
require_text 04-NAS-and-Storage.md "rotom-nas-docker-recovery.service"
require_text 05-Backup-and-Restore.md "## Run and Verify Rotom Restic Backup"
require_text 05-Backup-and-Restore.md "## Rehearse a Complete Rotom Restic Restore in Isolation"
require_text 05-Backup-and-Restore.md "rotom-restic-backup.service"
require_text 05-Backup-and-Restore.md "Changes Rotom and protected storage/repository state"
require_text 06-Maintenance-and-Automation.md "## Investigate a Failed Timer or Automation"
require_text 06-Maintenance-and-Automation.md "### Verify or recover repository publication"
require_text 07-Users-and-Permissions.md "## Diagnose an Identity, Ownership, or Access Failure"
require_text 07-Users-and-Permissions.md "### Rotom-side SSH client and access register"
require_text 07-Users-and-Permissions.md '`id_ed25519_github`'
require_text 07-Users-and-Permissions.md 'Never use `chmod 777`'

require_text 01-Rotom-Server-Inventory.md "the current intended runtime is therefore 20 running containers and those three intentionally stopped containers"
require_text 01-Rotom-Server-Inventory.md "Rotom Support"
require_text 02-Docker-Services.md '| Jared Wines | Supported stopped site |'
require_text 02-Docker-Services.md "the current runtime has 20 running containers and those three stopped containers"
require_text 02-Docker-Services.md '| Rotom Support | Supported active service |'
require_text 04-NAS-and-Storage.md '`documents/paperless/` for authoritative Paperless media'
require_text 04-NAS-and-Storage.md '`games/`, `movies/`, and `shows/` as root-level authoritative content'
require_text 04-NAS-and-Storage.md 'nested non-creating `games/roms` bind at `/romm/library/roms`'
require_text 02-Docker-Services.md '## RomM Upload and Metadata-Provider Contract'
require_text 07-Users-and-Permissions.md 'browser-uploaded ROM files were observed as `root:5000`, mode `0644`'
require_text 03-Network-and-Domains.md '`jaredwines.com` is currently intentionally stopped'
require_text 03-Network-and-Domains.md 'Glances no longer has a host listener'
require_text 03-Network-and-Domains.md '`support.rotom.casa`'
require_text 06-Maintenance-and-Automation.md 'Docker-socket access remains root-equivalent'
require_text 06-Maintenance-and-Automation.md '/srv/rotom/appdata/platform/mkdocs-rr/repository'
require_text 07-Users-and-Permissions.md 'Aloha'\''s active content and Jared Wines'\'' intentionally stopped site content'
require_text 08-Rotom-Directory-Tree.txt 'the current runtime is 20 running and three intentionally stopped.'
require_text 08-Rotom-Directory-Tree.txt 'mkdocs-rr/compose.yaml'

reject_text '| Jared Wines | **Needs Verification** |' "$REPO_ROOT/runbook"/0[1-8]-*
reject_text '**Jared Wines `502`:** expected under the unresolved current design.' "$REPO_ROOT/runbook"/0[1-8]-*
reject_text "Arcane's live 2026-10-15 settings have automatic updates, auto-heal, and scheduled pruning disabled" "$REPO_ROOT/runbook"/0[1-8]-*
reject_text '**Current live verification — 2026-10-15:** Arcane automatic updates are disabled' "$REPO_ROOT/runbook"/0[1-8]-*
reject_text 'Available Sources remains the RS membership boundary' \
    "$REPO_ROOT/AGENTS.md" "$REPO_ROOT/README.md" "$REPO_ROOT/runbook"/0[1-8]-* \
    "$REPO_ROOT/architecture"/*.md "$REPO_ROOT/guide"/*.md "$REPO_ROOT/internals"/*.md \
    "$REPO_ROOT/internals/agents"/*.md "$REPO_ROOT/internals/tooling/README.md"
reject_text 'not an RS member' \
    "$REPO_ROOT/AGENTS.md" "$REPO_ROOT/README.md" "$REPO_ROOT/runbook"/0[1-8]-* \
    "$REPO_ROOT/architecture"/*.md "$REPO_ROOT/guide"/*.md "$REPO_ROOT/internals"/*.md \
    "$REPO_ROOT/internals/agents"/*.md "$REPO_ROOT/internals/tooling/README.md"

if grep -nE 'JAR-[0-9]+' "$REPO_ROOT/runbook"/0[1-8]-* >/dev/null 2>&1; then
    fail "operational references contain non-literal uppercase ticket labels"
else
    pass "operational references contain no non-literal uppercase ticket labels"
fi

invalid_labels=$(grep -hE '^\*\*(Read-only|Changes Rotom|Credential-sensitive|PVE|Destructive)' \
    "$REPO_ROOT/runbook"/0[2-7]-*.md | grep -vFx -e '**Read-only**' \
    -e '**Read-only; may activate an existing automount**' \
    -e '**Changes Rotom**' \
    -e '**Changes Rotom and protected storage/repository state**' \
    -e '**Credential-sensitive**' \
    -e '**PVE — Jared executes**' \
    -e '**Destructive — explicit approval required**' || true)
if [[ -n "$invalid_labels" ]]; then
    fail "unapproved procedure command label: $invalid_labels"
else
    pass "procedure command labels use approved forms"
fi

for pair in \
    '02-Docker-Services.md:Diagnose and Recover a Container or Docker-Backed Website' \
    '03-Network-and-Domains.md:Diagnose a Proxy, Listener, DNS, TLS, Routing, or External-Access Failure' \
    '04-NAS-and-Storage.md:Diagnose and Recover a Configured NAS Mount' \
    '05-Backup-and-Restore.md:Start by Task or Symptom' \
    '06-Maintenance-and-Automation.md:Start by Task or Symptom' \
    '07-Users-and-Permissions.md:Start by Task or Symptom'
do
    file=${pair%%:*}; heading=${pair#*:}
    grep -Fq -- "## $heading" "$REPO_ROOT/runbook/$file" && pass "router destination: $file#$heading" || fail "missing router destination: $file#$heading"
done

if find "$REPO_ROOT" -maxdepth 2 -type f -path '*/runbooks/*' | grep -q .; then
    fail "parallel runbooks layer still contains files"
else
    pass "parallel runbooks layer absent"
fi

if grep -n -E 'runbooks/|test-runbooks|staged pilot|pilot runbook|pending Available Sources addition|parallel runbook layer' \
    "$REPO_ROOT/runbook"/0[1-8]-* "$REPO_ROOT/README.md" >/dev/null 2>&1; then
    fail "obsolete pilot-layer wording remains"
else
    pass "obsolete pilot-layer wording absent"
fi

while IFS= read -r record; do
    source=${record%%:*}; link=${record#*:}
    target=${link#](}; target=${target%%#*}; target=${target%% *}
    case "$target" in ''|http:*|https:*|mailto:*|'<'*) continue ;; esac
    target=${target//%20/ }
    [[ -e "$(dirname "$source")/$target" ]] || fail "broken local link: $source -> $target"
done < <(grep -HoE '\]\([^)]+' "$REPO_ROOT/runbook"/0[0-7]-*.md "$REPO_ROOT/README.md" | sort -u)
pass "local link target scan completed"

while IFS= read -r record; do
    source=${record%%:*}
    link=${record#*:}
    link=${link#](}
    target=${link%%#*}
    fragment=${link#*#}

    if [[ -n "$target" ]]; then
        target=${target//%20/ }
        destination="$(dirname "$source")/$target"
    else
        destination=$source
    fi

    matched=0
    while IFS= read -r heading; do
        slug=$(printf '%s\n' "$heading" |
            tr '[:upper:]' '[:lower:]' |
            sed -E 's/`//g; s/<[^>]*>//g; s/[^[:alnum:] _-]//g; s/[[:space:]]+/-/g; s/^-+//; s/-+$//')
        if [[ "$slug" == "$fragment" ]]; then
            matched=1
            break
        fi
    done < <(sed -nE 's/^#{1,6}[[:space:]]+//p' "$destination")

    if (( matched == 0 )); then
        fail "broken local fragment: ${source#$REPO_ROOT/} -> $link"
    fi
done < <(grep -H -oE '\]\([^)]*#[^)]+' \
    "$REPO_ROOT/runbook"/0[0-7]-*.md "$REPO_ROOT/README.md" | sort -u)
pass "local fragment target scan completed"

for file in "$REPO_ROOT/runbook"/*.md "$REPO_ROOT"/*.md; do
    fences=$(grep -c '^```' "$file" || true)
    (( fences % 2 == 0 )) && pass "balanced fences: ${file#$REPO_ROOT/}" || fail "unbalanced fences: ${file#$REPO_ROOT/}"
done

if grep -R -n -E -- '-----BEGIN (OPENSSH|RSA|EC|DSA) PRIVATE KEY-----|(^|[[:space:]])(token|password|secret)[[:space:]]*=[[:space:]]*[^<[:space:]]' \
    "$REPO_ROOT/runbook"/0[0-8]-* "$REPO_ROOT/README.md" "$REPO_ROOT/support" >/dev/null 2>&1; then
    fail "possible secret or private-key material found"
else
    pass "no secret/private-key material pattern found"
fi

if (( FAILURES > 0 )); then
    printf '\nNUMBERED RR RUNBOOK TESTS: FAIL (%d problem(s))\n' "$FAILURES" >&2
    exit 1
fi

printf '\nNUMBERED RR RUNBOOK TESTS: PASS\n'
